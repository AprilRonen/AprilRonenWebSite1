<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <link rel="stylesheet" type="text/css" href="StyleSheet.css" />
    <meta charset="utf-8" />
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    
    <header>
		<section class="header_top">
			
			<section class="header_date">
			<asp:Label ID="DateLabel" runat="server"></asp:Label>
			<asp:Image ID="DayImage" runat="server"/>
		</section>
				
		</section>
			
		<nav class="main_nav">  
			<h1>Harry Potter</h1>
			<a href="Default.aspx">Home Page</a>
			<a href="FirstPage.aspx">Key Characters</a>
			<a href="Spells.aspx">Spellbook</a> 
			<a href="Creatures.aspx">Creatures</a>
			<a href="Classes.aspx">Hogwarts Classes</a>
            <a id="house" runat="server" href="TheHouses.aspx">Hogwarts Houses</a>

			<a class="login_logout" ID="LoginLogout" runat="server"></a>
		</nav>
	</header>
		
	<section class="center">
		<aside>
				<div class="sidebar-box">
			<h3>Hogwarts Notice Board</h3>
			<ul>
				<li><strong>Quidditch:</strong> Gryffindor vs. Slytherin this Saturday!</li>
				<li><strong>Reminder:</strong> Third-floor corridor is strictly forbidden.</li>
				<li><strong>Lost:</strong> Neville's toad, Trevor. If found, return to Gryffindor tower.</li>
			</ul>
		</div>

		<div class="sidebar-box">
			<h3>House Points</h3>
			<table class="points-table">
				<tr><td>🦁 Gryffindor</td><td><strong>450</strong></td></tr>
				<tr><td>🐍 Slytherin</td><td><strong>420</strong></td></tr>
				<tr><td>🦅 Ravenclaw</td><td><strong>380</strong></td></tr>
				<tr><td>🦡 Hufflepuff</td><td><strong>390</strong></td></tr>
			</table>
		</div>
		</aside>
			
		<main>
			<asp:ContentPlaceHolder id="ContentPlaceHolderMain" runat="server">
			</asp:ContentPlaceHolder>
		</main>
	</section>
			
	<footer>
			<p>© 2026 Hogwarts School of Witchcraft and Wizardry. All Magic Reserved.</p>
            <p class="marauders-motto">"I solemnly swear that I am up to no good" 🐾</p>
	</footer>
    
	<asp:ContentPlaceHolder id="ContentPlaceHolderScript" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>